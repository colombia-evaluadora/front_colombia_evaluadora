{
  "name": "colombiaevaluadorav2",
  "compatibility_date": "2026-07-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    // El Worker necesita el binding para poder servir los estáticos él mismo
    // en el fallback de worker/index.js.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sin esto, `/api/*` lo atiende el servidor de assets: los POST dan 405 y
    // los GET devuelven index.html por el `not_found_handling` de arriba. Con
    // la regla, esas rutas entran al Worker, que las reenvía al gateway; todo
    // lo demás sigue yendo directo a los estáticos.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Mismo destino que `VITE_APP_API_PROXY_TARGET` usa en dev. Va acá y no en
    // el bundle porque lo resuelve el Worker en el servidor: el navegador nunca
    // ve esta URL (es HTTP plano, y el sitio es HTTPS).
    "API_PROXY_TARGET": "http://172.233.184.248:8080",
  },
}
