# Plantilla del .env de BUILD. Copiar a `.env` para desarrollo local.
#
# ---- AVISO: esto NO es un fichero de secretos -------------------------------
#
# Vite hornea todo lo que empiece por `VITE_APP_` DENTRO del JavaScript que se
# sirve al navegador. Cualquiera puede leerlo con devtools. No pongas acá
# tokens, claves ni credenciales: los secretos de verdad viven en el backend,
# detrás del gateway.
#
# En CI/CD el contenido de este fichero viaja como el secreto `ENV_FILE` del
# GitHub Environment correspondiente (`test` / `production`) y `deploy.yml` lo
# escribe como `.env` antes de `pnpm build`. Se guarda como secreto por higiene
# —no ensuciar el repo con URLs de infraestructura—, no por confidencialidad.
#
# Los defaults de cada clave viven en `src/config/env.ts`; si una falta, el
# build NO falla, usa el default. Por eso `setup-environment-secrets.sh`
# compara contra este fichero y avisa de las que falten.

# Base de todas las llamadas HTTP del cliente (`api-client.ts`).
# Se deja en `/api` para que las peticiones salgan al MISMO origen: en dev las
# reenvía el proxy de Vite y en producción el Worker (`worker/index.js`).
VITE_APP_API_URL=/api

# `active` monta MSW y sirve datos falsos; `inactive` pega al backend real.
VITE_APP_ENABLE_API_MOCKING=inactive

# URL pública de la app. Se usa para construir enlaces absolutos.
VITE_APP_APP_URL=http://localhost:5173

# A dónde reenvía `/api/*` el DEV SERVER de Vite (`server.proxy`).
# En producción el equivalente es la variable `API_PROXY_TARGET` del Worker,
# que NO sale de acá: se define como variable del GitHub Environment.
VITE_APP_API_PROXY_TARGET=http://172.233.184.248:8080

# Identifica esta app ante el SSO (`?app=` en /sso-admin/myMenu) para que
# resuelva rutas, menú y permisos.
VITE_APP_NAME=COLOMBIA-EVALUADORA

# Kill-switch del modo offline: `off` | `read` | `full` (default `read`).
# `off` desregistra el Service Worker de la PWA en la próxima carga y no
# persiste datos. Ver docs/offline/KILL-SWITCH.md.
VITE_APP_OFFLINE=read

# Clave PÚBLICA VAPID propia para Web Push (notification-service, PR SSO #690).
# Vacía = el botón "Activar en este dispositivo" no aparece. Debe ser la MISMA
# que `VAPID_PUBLIC_KEY` del notification-service de ese entorno (el par se
# genera con `npx web-push generate-vapid-keys`; base64url, ~87 caracteres).
# Es pública por diseño; la PRIVADA (`VAPID_PRIVATE_KEY`) vive solo en el
# backend y nunca va en este fichero.
VITE_APP_VAPID_PUBLIC_KEY=

# Piloto offline: quién puede desmarcar "Este es un equipo compartido" en el
# login (y así guardar datos en el equipo). Correos y/o roles del JWT separados
# por comas; `*` = todos; vacío = nadie (todo equipo queda compartido).
# Ej.: VITE_APP_OFFLINE_PILOT=docente1@colegio.edu.co,CEVAL-DOCENTE_PILOTO
VITE_APP_OFFLINE_PILOT=
# Días máximos sin conexión (offline de meses). Default 180.
VITE_APP_OFFLINE_MAX_DAYS=180
# Autopreparación en segundo plano en equipos personales: `on` (default) u
# `off`. Con `on`, con red y la app quieta se vuelve a "Preparar" al entrar y
# cada pocas horas; en la app instalada, la primera vez prepara todo el año.
VITE_APP_OFFLINE_AUTO_PREPARE=on

# Gateway WebSocket de tiempo real (chat, notificaciones; comms-service, PR SSO
# #692). Vacío = desactivado y las pantallas usan polling. Con mocks activos se
# ignora (gateway simulado en memoria).
# Recomendado: `/api/comms/ws` (relativa, mismo origen): el cliente la pasa a
# ws:/wss: según la página; en dev la reenvía el proxy de Vite (`ws: true`) y
# en deploy el Worker (`worker/index.js`). También admite absoluta, p. ej.
# `wss://testv2.colombiaevaluadora.com/api/comms/ws`.
VITE_APP_REALTIME_URL=
