# Plantilla del .env de BUILD. Copiar a `.env` para desarrollo local.
#
# ---- AVISO: esto NO es un fichero de secretos -------------------------------
#
# Vite hornea todo lo que empiece por `VITE_APP_` DENTRO del JavaScript que se
# sirve al navegador. Cualquiera puede leerlo con devtools. No pongas acá
# tokens, claves ni credenciales: los secretos de verdad viven en el backend,
# detrás del gateway.
#
# En CI/CD el contenido de este fichero viaja como el secreto `ENV_FILE` del
# GitHub Environment correspondiente (`test` / `production`) y `deploy.yml` lo
# escribe como `.env` antes de `pnpm build`. Se guarda como secreto por higiene
# —no ensuciar el repo con URLs de infraestructura—, no por confidencialidad.
#
# Los defaults de cada clave viven en `src/config/env.ts`; si una falta, el
# build NO falla, usa el default. Por eso `setup-environment-secrets.sh`
# compara contra este fichero y avisa de las que falten.

# Base de todas las llamadas HTTP del cliente (`api-client.ts`).
# Se deja en `/api` para que las peticiones salgan al MISMO origen: en dev las
# reenvía el proxy de Vite y en producción el Worker (`worker/index.js`).
VITE_APP_API_URL=/api

# `active` monta MSW y sirve datos falsos; `inactive` pega al backend real.
VITE_APP_ENABLE_API_MOCKING=inactive

# URL pública de la app. Se usa para construir enlaces absolutos.
VITE_APP_APP_URL=http://localhost:5173

# A dónde reenvía `/api/*` el DEV SERVER de Vite (`server.proxy`).
# En producción el equivalente es la variable `API_PROXY_TARGET` del Worker,
# que NO sale de acá: se define como variable del GitHub Environment.
VITE_APP_API_PROXY_TARGET=http://172.233.184.248:8080

# Identifica esta app ante el SSO (`?app=` en /sso-admin/myMenu) para que
# resuelva rutas, menú y permisos.
VITE_APP_NAME=COLOMBIA-EVALUADORA
